generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String

  playlists Playlist[]
}

model Playlist {
  id Int @id @default(autoincrement())
  title String
  musics Music[]

  userId Int
  user User @relation(fields: [userId], references: [id])
}

model Music {
  id Int @id @default(autoincrement())
  title String
  url String
  thumbnail String

  playlistId Int
  playlist Playlist @relation(fields: [playlistId], references: [id])
}